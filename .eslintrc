{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "mjs": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never"
      }
    ],
    "import/no-unresolved": "off",
    "linebreak-style": ["error", "unix"],
    "max-len": [
      "error",
      {
        "code": 128,
        "tabWidth": 2,
        "ignoreUrls": true
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allowAfterThis": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "plugins": [
        "@typescript-eslint"
      ],
      "rules": {
        "no-unused-vars": "off",
        "no-undef": "off",
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "args": "none"
          }
        ],
        "class-methods-use-this": [
          "error",
          {
            "exceptMethods": [
              "icon",
              "render"
            ]
          }
        ],
        "import/extensions": [
          "error",
          "never",
          {
            "json": "always"
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.js"
      ],
      "env": {
        "jest": true
      }
    }
  ],
  "settings": {
    "import/extensions": [
      ".js",
      ".mjs",
      ".ts",
      ".tsx"
    ],
    "import/parsers": {
      "@typescript-eslint/parser": [
        ".ts",
        ".tsx"
      ]
    },
    "import/resolver": {
      "node": {
        "extensions": [
          ".js",
          ".mjs",
          ".ts",
          ".tsx"
        ]
      }
    }
  }
}
